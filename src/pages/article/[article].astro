---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

export const articles = await Astro.glob("../news/*.md");

export function getStaticPaths() {
    return articles.map((markdownFile) => {
        return {
            params: {
                article: markdownFile.url?.substring("/news/".length),
            },
        };
    });
}

const { article } = Astro.params;

const articlePath = "/news/" + article;
const currentArticle = articles.find((article) => {
    console.log(article.url, articlePath);
    return article.url == articlePath;
});
---

<Layout title="Welcome to Astro.">
    <section>
        <h2>{currentArticle?.frontmatter.title}</h2>
        <p>{currentArticle?.rawContent.call(this)}</p>
    </section>
</Layout>

<style is:global></style>
