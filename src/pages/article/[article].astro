---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

export const articles = await Astro.glob("/public/cms/articles/*.md");

export function getStaticPaths() {
    return articles.map((markdownFile) => {
        let fileUrl = markdownFile.file?.substring(
            markdownFile.file.lastIndexOf("/") + 1,
            markdownFile.file.length - ".md".length
        );
        return {
            params: {
                article: fileUrl,
            },
        };
    });
}

const { article } = Astro.params;

const articlePath = article + ".md";
const currentArticle = articles.find((article) => {
    return article.file.endsWith(articlePath);
});
---

<Layout title="Welcome to Astro.">
    <section>
        <h2>{currentArticle?.frontmatter.title}</h2>
        <hr />
        <p>{currentArticle?.rawContent.call(this)}</p>
    </section>
</Layout>

<style>
    section {
        text-align: left;
        height: 80vh;
    }
</style>
