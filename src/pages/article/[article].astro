---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

export async function loadArticles() {
    try {
        return await Astro.glob("/public/cms/articles/*.md");
    } catch (e) {
        return [];
    }
}
export const articles = await loadArticles();

export async function getStaticPaths() {
    return articles.map((markdownFile) => {
        let fileUrl = markdownFile.file?.substring(
            markdownFile.file.lastIndexOf("/") + 1,
            markdownFile.file.length - ".md".length
        );
        return {
            params: {
                article: fileUrl,
            },
            props: {
                markdownFile,
            },
        };
    });
}

const { Content, frontmatter } = Astro.props.markdownFile;
---

<Layout title="Welcome to Astro.">
    <section>
        <h2>{frontmatter.title}</h2>
        <hr />
        <Content />
    </section>
</Layout>

<style>
    section {
        text-align: left;
        height: 80vh;
    }
</style>
