---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout title="Vladimír Podivínský - VKO Litovel" includeHeader={false}>
    <section>
        <h1>404</h1>
        <p>Ups. Tuto stránku se nám bohužel nepovedlo najít.</p>
        <a title="Zpět na hlavní stránku" href="/">Zpět na hlavní stránku</a>
    </section>
</Layout>

<style>
    h1 {
        font-size: 3rem;
    }
    :root {
        --nav-height: calc(calc(0.28125rem * 2 + 48px) * 2);
        --footer-height: calc(2rem + 3em);
        --min-height: calc(
            100vh - var(--nav-height) - var(--footer-height) - 1rem
        );
    }
    section {
        text-align: center;
        display: flex;
        min-height: var(--min-height);
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }
</style>
