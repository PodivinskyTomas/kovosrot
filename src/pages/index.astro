---
import Layout from "../layouts/Layout.astro";
import InformationTable from "../components/InformationTable.vue";
import "../styles/global.css";
import MapComponent from "../components/MapComponent.vue";
import AppNews from "../components/AppNews.vue";
import AppWarning from "../components/AppWarning.vue";
import { Content } from "../content/page_texts/about_us.md";

async function loadArticles() {
    try {
        return await Astro.glob("../pages/aktualita/*.md");
    } catch (e) {
        return [];
    }
}

const numberOfNewsToLoad = 3;
const news = (await loadArticles())
    .sort((d1, d2): number => {
        let date1 = new Date(d1.frontmatter.date).getTime();
        let date2 = new Date(d2.frontmatter.date).getTime();

        if (date1 > date2) {
            return 2;
        } else if (date1 < date2) {
            return 1;
        }
        return 0;
    })
    .slice(0, numberOfNewsToLoad);

const openingHoursFile = (
    await Astro.glob("../content/page_texts/provozni_doba.md")
)[0];
const fileContent = openingHoursFile.rawContent.call(this);

let openingHours: string[][] = [];
const rows: string[] = fileContent.split("\n");
for (const row of rows) {
    openingHours.push(row.split(" "));
}
---

<Layout title="Výkup kovového odpadu Vladimír Podivínský" includeHeader={true}>
    {
        news != null && news.length > 0 && (
            <section class="content__news">
                <h2 id="aktuality">Aktuality</h2>
                <AppNews files={news} />
            </section>
        )
    }
    <section class="content__about_us">
        <h2 id="oNás">O nás</h2>
        <Content class="about_us_text" />
    </section>
    <section class="content__opening_hours">
        <h2 id="otevíracíDoba">Kdy nás můžete zastihnout?</h2>
        <!-- <AppWarning
            class="warning"
            text="Dne 24.4 je státní svátek a bude zavřeno."
        /> -->
        <InformationTable information={openingHours} />
    </section>
    <section class="content__about_us">
        <h2 id="coVykupujeme" class="about_us_text">Co vykupujeme?</h2>
        <table>
            <tbody>
                <tr><td>Piliny a třísky železných kovů</td></tr>
                <tr><td>Piliny a třísky neželezných kovů</td></tr>
                <tr><td>Kovové obaly</td></tr>
                <tr><td>Železné kovy</td></tr>
                <tr><td>Neželezné kovy</td></tr>
                <tr><td>Měď, bronz, mosaz</td></tr>
                <tr><td>Hliník</td></tr>
                <tr><td>Olovo</td></tr>
                <tr><td>Zinek</td></tr>
                <tr><td>Železo a ocel</td></tr>
                <tr><td>Cín</td></tr>
                <tr><td>Směsné kovy</td></tr>
                <tr><td>Kabely neuvedené pod číslem 17 04 10</td></tr>
                <tr><td>Papír</td></tr>
                <tr><td>Kovy</td></tr>
            </tbody>
        </table>
    </section>
    <section class="content__contact">
        <h2 id="kontakt">Kontakt</h2>
        <div class="content__contact__wrapper">
            <div>
                <div class="circled">
                    <i class="fa-regular fa-envelope"></i>
                </div>
                <p><b>E-mail</b></p>
                <a href="mailto: 1podivinskaludmila@email.cz" class="email"
                    >1podivinskaludmila@email.cz</a
                >
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <p><b>Adresa</b></p>
                <p>Cholinská 1276/1, 784 01 Litovel</p>
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <p><b>Mobil</b></p>
                <a href="tel: +420 603 515 656">+420 603 515 656</a>
            </div>
        </div>
        <div class="mapComponent-section">
            <MapComponent />
        </div>
    </section>
</Layout>

<script is:inline>
    const menuCheckbox = document.getElementById("menu-toggle");
    if (menuCheckbox !== null) {
        const navLinks = document.getElementsByClassName("app-nav__link");
        for (const link of navLinks) {
            link.addEventListener("click", () => {
                menuCheckbox.checked = !menuCheckbox.checked;
            });
        }
    }
</script>

<style is:global>
    @import url("//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css");

    .mapComponent-section {
        height: 300px;
        margin-bottom: 1rem;
    }
    .warning {
        margin: 10px auto 10px auto !important;
        width: fit-content;
    }
    #contact {
        margin-bottom: 1.5rem;
    }
    #news {
        margin-bottom: 0.8rem;
    }
    #where-to-find-us {
        margin-bottom: 1rem;
    }
    .content__about_us p {
        width: 50%;
        margin: auto;
    }
    .contact-table {
        max-width: 330px !important;
    }
    .content__contact__wrapper {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }
    .content__contact__wrapper div {
        flex: 33%;
    }
    .circled {
        margin: auto;
        background-color: var(--p1);
        color: var(--white);
        --circled-icon-size: 36px;
        width: var(--circled-icon-size);
        height: var(--circled-icon-size);
        line-height: var(--circled-icon-size);
        border-radius: 100%;
        margin-bottom: 0.5rem;
    }

    table {
        border: 1px solid var(--n4);
        border-collapse: collapse;
        margin: auto;
        padding: 0rem;
    }

    table td {
        padding: 0.25rem 3rem;
    }

    tbody tr:nth-child(odd) {
        background-color: var(--n6);
    }

    tbody tr:nth-child(even) {
        background-color: var(--n5);
    }

    @media only screen and (max-width: 800px) {
        .content__contact__wrapper > div {
            flex: 100%;
            margin-bottom: 2rem;
        }
        .content__contact__wrapper > :nth-child(1) {
            order: 1;
        }
        .content__contact__wrapper > :nth-child(2) {
            order: 3;
        }
        .content__contact__wrapper > :nth-child(3) {
            order: 2;
        }
    }

    @media only screen and (max-width: 600px) {
        .content__about_us p {
            width: 100%;
            margin: auto;
        }
    }
</style>
