---
import Layout from "../layouts/Layout.astro";
import InformationTable from "../components/InformationTable.vue";
import "../styles/global.css";
import MapComponent from "../components/MapComponent.vue";
import AppNews from "../components/AppNews.vue";
import AppWarning from "../components/AppWarning.vue";
import WhatWeBuyTable from "../components/WhatWeBuyTable.vue";
import { Content } from "../content/page_texts/about_us.md";
import { frontmatter } from "../content/page_texts/what_we_buy.md";
import { frontmatter as faq_data } from "../content/page_texts/faq.md";
import type { MarkdownInstance } from "astro";
import { actualities, sortArticlesByDate } from "../logic/actualities";

const fetchedActualities = await fetchActualities();
async function fetchActualities() {
    try {
        return await Astro.glob("../pages/aktualita/*.md");
    } catch (e) {
        return [];
    }
}
const news = await actualities(fetchedActualities);

const oldestActiveVacationWarning = loadVacationWarning(fetchedActualities);

let oldestActiveVacationWarningText = null;
if (oldestActiveVacationWarning !== null) {
    oldestActiveVacationWarningText =
        oldestActiveVacationWarning.rawContent.call(this);
}
function loadVacationWarning(
    actualities: MarkdownInstance<Record<string, any>>[]
) {
    const actualitiesFromOldest = actualities
        .filter(
            (actuality) =>
                actuality.frontmatter.is_opening_hours_change === true
        )
        .sort((file1, file2) =>
            sortArticlesByDate(
                file1.frontmatter.show_until,
                file2.frontmatter.show_until
            )
        )
        .reverse();

    const currentDate = new Date();
    for (const oldestActuality of actualitiesFromOldest) {
        if (currentDate < new Date(oldestActuality.frontmatter.show_until)) {
            return oldestActuality;
        }
    }
    return null;
}

const openingHours: string[][] = await loadOpeningHours();
async function loadOpeningHours(this: any) {
    const openingHoursFile = await fetchOpeningHoursFile();
    const fileContent = openingHoursFile.rawContent.call(this);

    return extractOpeningHoursRows(fileContent);
}

async function fetchOpeningHoursFile() {
    return (await Astro.glob("../content/page_texts/provozni_doba.md"))[0];
}

function extractOpeningHoursRows(fileContent: string) {
    let openingHours: string[][] = [];
    for (let row of fileContent.split("\n")) {
        row = row.trim();
        if (row.length == 0 || row.indexOf(" ") === -1) continue;

        openingHours.push([
            row.substring(0, row.indexOf(" ")),
            row.substring(row.indexOf(" ") + 1),
        ]);
    }
    return openingHours;
}

let rows: string[] = frontmatter.list;
let faqTitle = faq_data.title;
let faq = faq_data.faq
---

<Layout title="Kovošrot Litovel Podivínský" includeHeader={true}>
    {
        news != null && news.length > 0 && (
            <section class="content__news">
                <h2 id="aktuality">Aktuality</h2>
                <AppNews files={news} />
            </section>
        )
    }
    <section class="content__about_us">
        <h2 id="oNás">O nás</h2>
        <Content class="about_us_text" />
    </section>
    <section class="content__opening_hours">
        <h2 id="provozníDoba">Kdy nás můžete zastihnout?</h2>
        {
            oldestActiveVacationWarning !== null && (
                <>
                    <p id="show_warning_until" class="hidden">
                        {oldestActiveVacationWarning.frontmatter.show_until}
                    </p>
                    <AppWarning
                        id="opening_hours_warning"
                        class="warning hidden"
                        text={oldestActiveVacationWarningText}
                    />
                </>
            )
        }
        <InformationTable information={openingHours} />
    </section>
    <section class="content__about_us">
        <h2 id="coVykupujeme" class="about_us_text">Co vykupujeme?</h2>
        <WhatWeBuyTable rows={rows} />
        <p class="what_we_buy_paragraph">
            <i>
               (Minimální částka převedená na účet je 100 Kč.<br> Kovový odpad za cenu menší než 100 Kč může být přebrán k likvidaci zdarma.<br> Barevné kovy vykupujeme minimálně od 1 kg.)
            </i>
        </p>
    </section>
    <section>
        <h2 id="faq" class="about_us_text">{faqTitle}</h2>
        <div class="faq_container">
            {faq.map(faq => (
                    <div class="accordion">
                        <i class="fa-solid fa-caret-down  fa-2xl"" style="color: var(--p1);"></i>
                        {faq.faq_question}
                    </div>
                    <div class="panel">
                        <p>{faq.faq_answer}</p>
                    </div>
            ))}
        </div>
    </section>
    <section class="content__contact">
        <h2 id="kontakt">Kontakt</h2>
        <div class="content__contact__wrapper">
            <div>
                <div class="circled">
                    <i class="fa-regular fa-envelope"></i>
                </div>
                <p><b>E-mail</b></p>
                <a
                    href="mailto: 1podivinskaludmila@email.cz"
                    class="email"
                    title="Email provozovatele">1podivinskaludmila@email.cz</a
                >
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <p><b>Adresa</b></p>
                <a
                    title="Lokace provozony na mapách Google"
                    href="https://www.google.com/maps/place/V%C3%BDkup+kovov%C3%A9ho+odpadu+Litovel/@49.6908301,17.0708025,16.56z/data=!4m6!3m5!1s0x471241dadd90dcef:0x72b3bbfc516c8c64!8m2!3d49.6910708!4d17.0720796!16s%2Fg%2F11shwm46hh?hl=en"
                    >Cholinská 1276/1, 784 01 Litovel</a
                >
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <p><b>Telefon</b></p>
                <p>(zde volejte pro aktuální ceny)</p>
                <a href="tel: +420 603 515 656" title="Telefon na provozovatele"
                    >+420 603 515 656</a
                >
            </div>
        </div>
        <div class="mapComponent-section">
            <MapComponent client:visible />
        </div>
    </section>
</Layout>

<script is:inline>
const menuCheckbox = document.getElementById("menu-toggle");
if (menuCheckbox !== null) {
    const navLinks = document.getElementsByClassName("app-nav__link");
    for (const link of navLinks) {
        link.addEventListener(
            "click",
            () => {
                menuCheckbox.checked = !menuCheckbox.checked;
            },
            { passive: true }
        );
    }
}

const showWarningUntil = document.getElementById("show_warning_until");
if (showWarningUntil !== null) {
    const showUntilDate = new Date(showWarningUntil.innerText.trim());
    if (new Date() < showUntilDate) {
        const warning = document.getElementById("opening_hours_warning");
        warning.classList.remove("hidden");
    }
}

let acc = document.getElementsByClassName("accordion");
for (let i = 0; i < acc.length; i++) {
  acc[i].addEventListener("click", function() {
    this.classList.toggle("active");
    let panel = this.nextElementSibling;
    if (panel.style.maxHeight) {
      panel.style.maxHeight = null;
    } else {
      panel.style.maxHeight = panel.scrollHeight + "px";
    } 
  });
}
</script>

<style is:global>
    @import url("//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css");

    .what_we_buy_paragraph {
        margin-top: 1rem !important;
    }
    .hidden {
        display: none;
    }
    .mapComponent-section {
        height: 300px;
        margin-bottom: 1rem;
    }
    .warning {
        margin: 10px auto 10px auto !important;
        width: fit-content;
    }
    #kontakt {
        margin-bottom: 1.5rem;
    }
    #aktuality {
        margin-bottom: 0.8rem;
    }
    .content__about_us p {
        width: 50%;
        margin: auto;
    }
    .contact-table {
        max-width: 330px !important;
    }
    .content__contact__wrapper {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }
    .content__contact__wrapper div {
        flex: 33%;
    }
    .circled {
        margin: auto;
        background-color: var(--p1);
        color: var(--white);
        --circled-icon-size: 38px;
        width: var(--circled-icon-size);
        height: var(--circled-icon-size);
        line-height: var(--circled-icon-size);
        border-radius: 100%;
        margin-bottom: 1rem;
    }

    @media only screen and (max-width: 800px) {
        .content__contact__wrapper > div {
            flex: 100%;
            margin-bottom: 2rem;
        }
        .content__contact__wrapper > :nth-child(1) {
            order: 1;
        }
        .content__contact__wrapper > :nth-child(2) {
            order: 3;
        }
        .content__contact__wrapper > :nth-child(3) {
            order: 2;
        }

        .accordion {
            width: 80% !important;
        }
        .panel {
            width: 80% !important;
        }
    }

    @media only screen and (max-width: 600px) {
        .content__about_us p {
            width: 100%;
            margin: auto;
        }
    }

    .faq_container {
        text-align: left;
    }
    .accordion {
        background-color: var(--n5);
        cursor: pointer;
        padding: 18px;
        border: none;
        text-align: left;
        outline: none;
        font-size: 15px;
        transition: 0.4s;
        width: 50%;
        margin: auto;
        border-bottom: 1px solid black;
        display: flex;
        column-gap: 0.5rem;
        align-items: center
    }

    .active, .accordion:hover {
        background-color: #ccc;
    }

    .panel {
        width: 50%;
        margin: auto;
        background-color: white;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.2s ease-out;
        padding: 0 18px;

        & p {
            margin: 1em 0;
        }
    }
</style>
