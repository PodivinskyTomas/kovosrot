---
import Layout from "../layouts/Layout.astro";
import InformationTable from "../components/InformationTable.vue";
import "../styles/global.css";
import MapComponent from "../components/MapComponent.vue";
import AppNews from "../components/AppNews.vue";

const numberOfNewsToLoad = 3;
let news;
try {
    news = (await Astro.glob("/public/cms/articles/*.md"))
        .sort((d1, d2): number => {
            let date1 = new Date(d1.frontmatter.date).getTime();
            let date2 = new Date(d2.frontmatter.date).getTime();

            if (date1 < date2) {
                return 1;
            } else if (date1 > date2) {
                return 2;
            }
            return 0;
        })
        .slice(0, numberOfNewsToLoad);
} catch (exception) {
    news = null;
}

const openingHours = [
    ["Pondělí", "8:00-15:30"],
    ["Úterý", "8:00-15:30"],
    ["Středa", "8:00-15:30"],
    ["Čtvrtek", "8:00-15:30"],
    ["Pátek", "8:00-15:30"],
    ["Sobota", "9:00-12:00"],
    ["Neděle", "Zavřeno"],
];
---

<Layout title="Vladimír Podivínský - VKO Litovel" includeHeader={true}>
    {
        news != null && news.length > 0 && (
            <section class="content__news">
                <h2 id="news">Aktuality</h2>
                <AppNews files={news} />
            </section>
        )
    }
    <section class="content__opening_hours">
        <h2 id="opening-hours">Kdy nás můžete zastihnout?</h2>
        <InformationTable information={openingHours} />
    </section>
    <section>
        <h2 id="where-to-find-us">Kde nás najít?</h2>
        <MapComponent client:visible />
        <p>Cholinská 1276/1, 784 01 Litovel</p>
    </section>
    <section class="content__contact">
        <h2 id="contact">Kontakt</h2>
        <div class="information-table">
            <div class="information-table__row">
                <div>E-mail</div>
                <a href="mailto: 1podivinskaludmila@email.cz"
                    >1podivinskaludmila@email.cz</a
                >
            </div>
            <div class="information-table__row">
                <div>Mobil</div>
                <a href="tel: +420 603 515 656">+420 603 515 656</a>
            </div>
            <div class="information-table__row">
                <div>IČO</div>
                <div>70011231</div>
            </div>
        </div>
    </section>
</Layout>

<style is:global>
    #news {
        margin-bottom: 0.8rem;
    }
    #where-to-find-us {
        margin-bottom: 1rem;
    }
</style>
