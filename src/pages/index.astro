---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import NewsCard from "../components/NewsCard.astro";
import { Content } from "../page_texts/about_us.md";
import { frontmatter } from "../page_texts/what_we_buy.md";
import { frontmatter as faq_data } from "../page_texts/faq.md";
import type { MarkdownInstance } from "astro";
import { actualities } from "../logic/actualities";

const fetchedActualities = await fetchActualities();
async function fetchActualities() {
    try {
        return Object.values(import.meta.glob("../pages/aktualita/*.md", { eager: true }));
    } catch (e) {
        return [];
    }
}
const news = await actualities(fetchedActualities);

const openingHours: string[][] = loadOpeningHours();
function loadOpeningHours(this: any) {
    const openingHoursFile = fetchOpeningHoursFile();
    const fileContent = openingHoursFile.rawContent.call(this);

    return extractOpeningHoursRows(fileContent);
}

function fetchOpeningHoursFile() {
    return Object.values(import.meta.glob("../page_texts/provozni_doba.md", { eager: true }))[0];
}

function extractOpeningHoursRows(fileContent: string) {
    let openingHours: string[][] = [];
    for (let row of fileContent.split("\n")) {
        row = row.trim();
        if (row.length == 0 || row.indexOf(" ") === -1) continue;

        openingHours.push([
            row.substring(0, row.indexOf(" ")),
            row.substring(row.indexOf(" ") + 1),
        ]);
    }
    return openingHours;
}

let rows: string[] = frontmatter.list;
let faqTitle = faq_data.title;
let faq = faq_data.faq
---

<Layout title="Kovošrot Litovel Podivínský" includeHeader={true}>
    <section class="content__news">
        <h2 id="aktuality">Aktuality</h2>
        <div>
            <div class="news-wrapper">
                {news.map((item) => (
                        <NewsCard item={item} isAll={false} />
                ))}
            </div>
            <a class="show_all" title="Zobrazit všechny aktuality" href="/aktuality/">Zobrazit vše</a>
        </div>
    </section>
    <section class="content__about_us">
        <h2 id="oNás">O nás</h2>
        <Content class="about_us_text" />
    </section>
    <section class="content__opening_hours">
        <h2 id="provozníDoba">Kdy nás můžete zastihnout?</h2>
        <div>
            <div class="information-table">
                {openingHours.map((row) => (
                    <div class="information-table__row">
                        {
                            row.map((col) => (
                                <div>
                                    { col }
                                </div>
                            ))
                        }
                    </div>
                ))}
            </div>
            <p>
                <i>Nutný příjezd nejpozději 10 minut, před koncem otevírací doby.</i>
            </p>
        </div>
    </section>
    <section class="content__about_us">
        <h2 id="coVykupujeme" class="about_us_text">Co vykupujeme?</h2>
        <table>
            <tbody>
            {rows.map((row) => (
                <tr>
                    <td>{ row }</td>
                </tr>
            ))}
            </tbody>
        </table>
        <p class="what_we_buy_paragraph">
            <i>
               (Minimální částka převedená na účet je 100 Kč.<br> Kovový odpad za cenu menší než 100 Kč může být přebrán k likvidaci zdarma.<br> Barevné kovy vykupujeme minimálně od 1 kg.)
            </i>
        </p>
    </section>
    <section>
        <h2 id="faq" class="about_us_text">{faqTitle}</h2>
        <div class="faq_container">
            {faq.map(faq => (
                    <div class="accordion">
                        <i class="fa-solid fa-caret-down  fa-2xl" style="color: var(--p1);">

                        </i>
                        {faq.faq_question}
                    </div>
                    <div class="panel">
                        <p>{faq.faq_answer}</p>
                    </div>
            ))}
        </div>
    </section>
    <section class="content__contact">
        <h2 id="kontakt">Kontakt</h2>
        <div class="content__contact__wrapper">
            <div>
                <div class="circled">
                    <i class="fa-regular fa-envelope"></i>
                </div>
                <p><b>E-mail</b></p>
                <a
                    href="mailto: 1podivinskaludmila@email.cz"
                    class="email"
                    title="Email provozovatele">1podivinskaludmila@email.cz</a
                >
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
                <p><b>Adresa</b></p>
                <a
                    title="Lokace provozony na mapách Google"
                    href="https://www.google.com/maps/place/V%C3%BDkup+kovov%C3%A9ho+odpadu+Litovel/@49.6908301,17.0708025,16.56z/data=!4m6!3m5!1s0x471241dadd90dcef:0x72b3bbfc516c8c64!8m2!3d49.6910708!4d17.0720796!16s%2Fg%2F11shwm46hh?hl=en"
                    >Cholinská 1276/1, 784 01 Litovel</a
                >
                <p>IČ: 70011231</p>
                <p>DIČ: CZ7201145303</p>
            </div>
            <div>
                <div class="circled">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <p><b>Telefon</b></p>
                <p>(zde volejte pro aktuální ceny)</p>
                <a href="tel: +420 603 515 656" title="Telefon na provozovatele"
                    >+420 603 515 656</a
                >
            </div>
        </div>
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4263.3314339041635!2d17.070393492976102!3d49.692158029962904!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x471241dadd90dcef%3A0x72b3bbfc516c8c64!2sV%C3%BDkup%20kovov%C3%A9ho%20odpadu%20Litovel!5e0!3m2!1sen!2scz!4v1734619868487!5m2!1sen!2scz"
            width="600"
            height="450"
            style="border:0; max-width: 100%;"
            allowfullscreen
            loading="lazy"
            title="Mapa, kde můžete najít náš podnik"
            referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
        <p><i><small>Živnostenský list vydal městský úřad Litovel č.j. ŽIV/36027/2017/Kr/ŽF</small></i></p>
    </section>
</Layout>

<style is:global>
    @import url("//cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css");

    .what_we_buy_paragraph {
        margin-top: 1rem !important;
    }
    .hidden {
        display: none;
    }
    .warning {
        margin: 10px auto 10px auto !important;
        width: fit-content;
    }
    #kontakt {
        margin-bottom: 1.5rem;
    }
    #aktuality {
        margin-bottom: 0.8rem;
    }
    .content__about_us p {
        width: 50%;
        margin: auto;
    }
    .contact-table {
        max-width: 330px !important;
    }
    .content__contact__wrapper {
        display: flex;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        justify-content: space-evenly;
    }
    .circled {
        background-color: var(--p1);
        color: var(--white);
        --circled-icon-size: 38px;
        width: var(--circled-icon-size);
        height: var(--circled-icon-size);
        line-height: var(--circled-icon-size);
        border-radius: 100%;
        margin: auto auto 1rem;
    }

    @media only screen and (max-width: 800px) {
        .content__contact__wrapper > div {
            flex: 100%;
            margin-bottom: 2rem;
        }
        .content__contact__wrapper > :nth-child(1) {
            order: 1;
        }
        .content__contact__wrapper > :nth-child(2) {
            order: 3;
        }
        .content__contact__wrapper > :nth-child(3) {
            order: 2;
        }

        .accordion {
            width: 80% !important;
        }
        .panel {
            width: 80% !important;
        }
    }

    @media only screen and (max-width: 600px) {
        .content__about_us p {
            width: 100%;
            margin: auto;
        }
    }

    .faq_container {
        text-align: left;
    }
    .accordion {
        background-color: var(--n5);
        cursor: pointer;
        padding: 18px;
        border: none;
        text-align: left;
        outline: none;
        font-size: 15px;
        transition: 0.4s;
        width: 50%;
        margin: auto;
        border-bottom: 1px solid black;
        display: flex;
        column-gap: 0.5rem;
        align-items: center
    }

    .active, .accordion:hover {
        background-color: #ccc;
    }

    .panel {
        width: 50%;
        margin: auto;
        background-color: white;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.2s ease-out;
        padding: 0 18px;

        & p {
            margin: 1em 0;
        }
    }
    .p-0 {
        padding: 0 !important;
    }
    .news-wrapper {
        display: flex;
        flex-wrap: wrap;
        margin: auto;
        justify-content: space-evenly;
    }

    .show_all {
        margin-top: 2.5rem;
        display: inline-block;
        border-radius: 12px;
        color: var(--n1);
        border: 1px solid var(--p1);
        background-color: var(--white);
        text-decoration: none;
        font-weight: bold;
        padding: 10px 28px;
        height: 1.5rem;
        line-height: 1.5rem;
        transition: 0.4s ease;
    }

    .show_all:hover {
        color: var(--white);
        background-color: var(--p1);
    }
    table {
        border: 1px solid var(--n4);
        border-collapse: collapse;
        margin: auto;
        padding: 0;
    }

    table td {
        padding: 0.25rem 3rem;
    }

    tbody tr:nth-child(odd) {
        background-color: var(--n6);
    }

    tbody tr:nth-child(even) {
        background-color: var(--n5);
    }
    .information-table {
        display: flex;
        flex-direction: column;
        margin: auto;
        max-width: 250px;
        border-left: 0.25rem solid var(--p1);
        padding-top: 0.25rem;
        padding-bottom: 0.25rem;
        padding-left: 0.5rem;
    }

    .information-table__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.3rem;
    }

    .information-table__row :first-child {
        font-weight: bold;
    }
</style>
