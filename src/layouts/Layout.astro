---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
    title: string;
    includeHeader?: boolean;
}

const { title, includeHeader = false } = Astro.props;
---

<BaseLayout title={title} includeHeader={includeHeader}>
    <slot />
</BaseLayout>

<style is:global>
    .content section {
        background-color: var(--n5);
        padding: var(--section-vertical-padding) var(--content-padding);
    }
    .content section h2 {
        scroll-margin-top: 4em;
        margin-bottom: 1rem;
    }
    .content > section:nth-of-type(odd) {
        background-color: var(--n6);
    }
</style>
