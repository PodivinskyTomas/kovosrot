---
import AppHeader from "../components/AppHeader.vue";
import AppNav from "../components/AppNav.vue";
import AppFooter from "../components/AppFooter.vue";
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

const title = `Kovošrot Podivínský - ${frontmatter.title}`;
---

<BaseLayout includeHeader={false} title={title} metaDescription="TODO">
    <article>
        <h2>{frontmatter.title}</h2>
        <hr />
        <slot />
    </article>
</BaseLayout>

<style>
    :root {
        --content-padding: 6rem;
        --section-vertical-padding: 3rem;
        --nav-height: calc(calc(0.28125rem * 2 + 48px) * 2);
        --footer-height: calc(2rem + 3em);
        --min-height: calc(
            100vh - var(--nav-height) - var(--footer-height) - 1rem
        );
    }

    article {
        padding-left: var(--content-padding);
        padding-right: var(--content-padding);
        background-color: var(--n5);
        padding-top: var(--section-vertical-padding);
        padding-bottom: var(--section-vertical-padding);
        text-align: left;
        min-height: var(--min-height);
        background-color: var(--n6);
    }
    article h2 {
        scroll-margin-top: 4em;
        margin-bottom: 1rem;
    }
</style>
