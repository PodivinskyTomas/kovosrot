---
import "../styles/global.css";
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

const title = `Kovošrot Podivínský - ${frontmatter.title}`;

let date: string = frontmatter.creation_date;
date = date.substring(0, date.indexOf("T")).replaceAll("-", ".");
const dateParts = date.split(".");
const finalDate = `${dateParts[2]}.${dateParts[1]}.${dateParts[0]}`;
---

<BaseLayout includeHeader={false} title={title} includeInSearchEngines={false}>
    <article>
        <div class="row">
            <h2>{frontmatter.title}</h2>
            <i>{finalDate}</i>
        </div>
        <hr />
        <slot />
    </article>
</BaseLayout>

<style>
    :root {
        --nav-height: calc(calc(0.28125rem * 2 + 48px) * 2);
        --footer-height: calc(2rem + 3em);
        --min-height: calc(
            100vh - var(--nav-height) - var(--footer-height) - 1rem
        );
    }

    article {
        padding: var(--section-vertical-padding) var(--content-padding);
        text-align: left;
        min-height: var(--min-height);
        background-color: var(--n6);
    }
    article hr {
        margin-top: 1rem;
    }
    .row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
    }
</style>
